rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function googleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function question(questionCode) {
      return get(/databases/$(database)/documents/questions/$(questionCode)).data;
    }

    function isQuestionHost(questionCode) {
      return signedIn() && question(questionCode).hostUid == request.auth.uid;
    }

    function round(roundId) {
      return get(/databases/$(database)/documents/scoreboardRounds/$(roundId)).data;
    }

    function isRoundHost(roundId) {
      return signedIn() && round(roundId).hostUid == request.auth.uid;
    }

    function validQuestionCode(questionCode) {
      return questionCode.matches('[A-Z0-9]S[0-9]Q[0-9][0-9]');
    }

    function validSessionKey(questionCode, sessionKey) {
      let number = question(questionCode).sessionNumber;
      return (number == 0 && sessionKey == 'S0')
        || (number == 1 && sessionKey == 'S1')
        || (number == 2 && sessionKey == 'S2')
        || (number == 3 && sessionKey == 'S3')
        || (number == 4 && sessionKey == 'S4')
        || (number == 5 && sessionKey == 'S5')
        || (number == 6 && sessionKey == 'S6')
        || (number == 7 && sessionKey == 'S7')
        || (number == 8 && sessionKey == 'S8')
        || (number == 9 && sessionKey == 'S9');
    }

    match /config/scoreboard {
      allow read: if signedIn();
      allow create: if googleUser()
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if false;
    }

    match /scoreboardRounds/{roundId} {
      allow read: if signedIn();
      allow create: if googleUser()
        && validQuestionCode(questionCode)
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.id == roundId;
      allow update, delete: if isRoundHost(roundId);

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && playerId == request.auth.uid
          && request.resource.data.id == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.tieBreakTimeMs == 0
          && request.resource.data.joinedAt == request.time
          && request.resource.data.keys().hasOnly(['id', 'nickname', 'score', 'tieBreakTimeMs', 'joinedAt'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 20;
        allow update: if isRoundHost(roundId) || (
          signedIn()
          && playerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 20
        );
        allow delete: if isRoundHost(roundId);
      }

      match /multiplierUses/{tokenId} {
        allow get: if signedIn();
        allow list: if false;
        allow create, update, delete: if false;
      }
    }

    match /questions/{questionCode} {
      allow get: if signedIn();
      allow list: if googleUser()
        && resource.data.hostUid == request.auth.uid;
      allow create: if googleUser()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.code == questionCode
        && request.resource.data.roundId is string
        && isRoundHost(request.resource.data.roundId);
      allow update: if isQuestionHost(questionCode)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.code == resource.data.code
        && isRoundHost(request.resource.data.roundId);
      allow delete: if isQuestionHost(questionCode);

      match /private/answerKey {
        allow read, write: if isQuestionHost(questionCode);
      }

      match /answers/{answerId} {
        allow get: if isQuestionHost(questionCode) || (
          signedIn()
          && answerId == question(questionCode).roundId + '_' + request.auth.uid
        );
        allow list: if isQuestionHost(questionCode);
        allow create: if signedIn()
          && request.resource.data.studentUid == request.auth.uid
          && answerId == request.resource.data.roundId + '_' + request.auth.uid
          && request.resource.data.id == answerId
          && request.resource.data.roundId == question(questionCode).roundId
          && validSessionKey(questionCode, request.resource.data.sessionKey)
          && question(questionCode).isOpen == true
          && request.resource.data.selections is list
          && request.resource.data.selections.size() > 0
          && request.resource.data.selections.size() <= 8
          && request.resource.data.selections.toSet().size() == request.resource.data.selections.size()
          && request.resource.data.selections.toSet().hasOnly([0, 1, 2, 3, 4, 5, 6, 7])
          && request.resource.data.multiplier == 1
          && request.resource.data.scoringMode == 'standard'
          && request.resource.data.awarded == false
          && request.resource.data.submittedAt == request.time
          && request.resource.data.keys().hasOnly(['id', 'studentUid', 'roundId', 'sessionKey', 'selections', 'multiplier', 'scoringMode', 'awarded', 'submittedAt']);
        allow update, delete: if isQuestionHost(questionCode);
      }
    }
  }
}
